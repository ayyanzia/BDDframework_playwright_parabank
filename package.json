{
  "name": "parabank-playwright-automation",
  "version": "4.0.0",
  "description": "ParaBank automation suite v4 — two-layer framework (Framework + Test Layer), 93 BDD Cucumber scenarios, ~80 Playwright API tests, shared browser session, enterprise HTML dashboard.",
  "type": "commonjs",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",

    "test:registration": "playwright test tests/registration.spec.js",
    "test:login": "playwright test tests/login.spec.js",
    "test:navigation": "playwright test tests/navigation.spec.js",
    "test:accounts-overview": "playwright test tests/accounts-overview.spec.js",
    "test:open-account": "playwright test tests/open-account.spec.js",
    "test:transfer-funds": "playwright test tests/transfer-funds.spec.js",
    "test:bill-pay": "playwright test tests/bill-pay.spec.js",
    "test:find-transactions": "playwright test tests/find-transactions.spec.js",
    "test:update-contact": "playwright test tests/update-contact.spec.js",
    "test:request-loan": "playwright test tests/request-loan.spec.js",
    "test:session": "playwright test tests/session.spec.js",
    "test:security": "playwright test tests/security.spec.js",
    "test:ui-usability": "playwright test tests/ui-usability.spec.js",
    "test:report": "playwright show-report test-results/html-report",

    "test:bdd": "cucumber-js",
    "test:bdd:smoke": "cucumber-js --tags \"@smoke\"",
    "test:bdd:sanity": "cucumber-js --tags \"@sanity\"",
    "test:bdd:regression": "cucumber-js --tags \"@regression\"",
    "test:bdd:module:login": "cucumber-js --tags \"@module:login\"",
    "test:bdd:module:registration": "cucumber-js --tags \"@module:registration\"",
    "test:bdd:module:navigation": "cucumber-js --tags \"@module:navigation\"",
    "test:bdd:module:accounts": "cucumber-js --tags \"@module:accounts-overview\"",
    "test:bdd:module:open-account": "cucumber-js --tags \"@module:open-account\"",
    "test:bdd:module:transfer": "cucumber-js --tags \"@module:transfer-funds\"",
    "test:bdd:module:bill-pay": "cucumber-js --tags \"@module:bill-pay\"",
    "test:bdd:module:find-transactions": "cucumber-js --tags \"@module:find-transactions\"",
    "test:bdd:module:update-contact": "cucumber-js --tags \"@module:update-contact\"",
    "test:bdd:module:request-loan": "cucumber-js --tags \"@module:request-loan\"",
    "test:bdd:module:session": "cucumber-js --tags \"@module:session\"",
    "test:bdd:module:security": "cucumber-js --tags \"@module:security\"",
    "test:bdd:module:ui-usability": "cucumber-js --tags \"@module:ui-usability\"",

    "test:api": "playwright test --config=tests/api/api.config.js",
    "test:api:auth": "playwright test --config=tests/api/api.config.js tests/api/specs/auth.api.spec.js",
    "test:api:customers": "playwright test --config=tests/api/api.config.js tests/api/specs/customers.api.spec.js",
    "test:api:accounts": "playwright test --config=tests/api/api.config.js tests/api/specs/accounts.api.spec.js",
    "test:api:transactions": "playwright test --config=tests/api/api.config.js tests/api/specs/transactions.api.spec.js",
    "test:api:transfer": "playwright test --config=tests/api/api.config.js tests/api/specs/transfer.api.spec.js",
    "test:api:deposit-withdraw": "playwright test --config=tests/api/api.config.js tests/api/specs/deposit-withdraw.api.spec.js",
    "test:api:bill-pay": "playwright test --config=tests/api/api.config.js tests/api/specs/bill-pay.api.spec.js",
    "test:api:loans": "playwright test --config=tests/api/api.config.js tests/api/specs/loans.api.spec.js",
    "test:api:negative": "playwright test --config=tests/api/api.config.js tests/api/specs/negative.api.spec.js",
    "test:api:registration": "playwright test --config=tests/api/api.config.js tests/api/specs/registration.api.spec.js",
    "test:api:session": "playwright test --config=tests/api/api.config.js tests/api/specs/session-token.api.spec.js",
    "test:api:headers": "playwright test --config=tests/api/api.config.js tests/api/specs/headers-content-type.api.spec.js",
    "test:hybrid": "playwright test --config=tests/specs/hybrid/hybrid.config.js",
    "test:hybrid:registration": "playwright test --config=tests/specs/hybrid/hybrid.config.js tests/specs/hybrid/registration-hybrid.spec.js",
    "test:hybrid:transfer": "playwright test --config=tests/specs/hybrid/hybrid.config.js tests/specs/hybrid/transfer-funds-hybrid.spec.js",
    "report:api": "playwright show-report test-results/api/html-report",

    "report:md": "node reporting/generate-report.js",
    "report:html": "node reporting/generate-html-report.js",
    "report:bdd": "node reporting/generate-report-cucumber.js && node reporting/generate-html-report-cucumber.js"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^13.2.0",
    "@faker-js/faker": "^10.5.0",
    "@playwright/test": "^1.61.1",
    "xlsx": "^0.18.5"
  }
}
